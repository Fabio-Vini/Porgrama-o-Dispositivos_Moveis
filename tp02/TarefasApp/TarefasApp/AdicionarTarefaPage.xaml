<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TarefasApp.AdicionarTarefaPage"
             Title="Adicionar Tarefa">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Título:"/>
        <Entry x:Name="TituloEntry"
               Placeholder="Digite o título"/>

        <Label Text="Descrição:"/>
        <Entry x:Name="DescricaoEntry"
               Placeholder="Digite a descrição"/>

        <Label Text="Data de criação:"/>
        <DatePicker x:Name="DataPicker"/>

        <Label Text="Prioridade:"/>
        <Picker x:Name="PrioridadePicker"
                Title="Selecione a prioridade">
            <Picker.Items>
                <x:String>Baixa</x:String>
                <x:String>Média</x:String>
                <x:String>Alta</x:String>
            </Picker.Items>
        </Picker>

        <Button Text="Adicionar"
                Clicked="Adicionar_Clicked"/>

        <Button Text="Cancelar"
                Clicked="Cancelar_Clicked"/>

    </VerticalStackLayout>

</ContentPage>