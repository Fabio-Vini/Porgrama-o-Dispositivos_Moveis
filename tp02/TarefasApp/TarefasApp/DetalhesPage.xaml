<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TarefasApp.DetalhesPage"
             Title="Detalhes da Tarefa">

    <VerticalStackLayout Padding="20" Spacing="12">

        <Label Text="Título"
               FontAttributes="Bold"/>
        <Label x:Name="TituloLabel"
               FontSize="20"/>

        <Label Text="Descrição"
               FontAttributes="Bold"/>
        <Label x:Name="DescricaoLabel"/>

        <Label Text="Data de criação"
               FontAttributes="Bold"/>
        <Label x:Name="DataLabel"/>

        <Label Text="Prioridade"
               FontAttributes="Bold"/>
        <Label x:Name="PrioridadeLabel"/>

        <Button Text="Voltar"
        Clicked="Voltar_Clicked"/>

        <Button Text="Editar"
                Margin="0,15,0,0"
                Clicked="Editar_Clicked"/>

        <Button Text="Excluir"
                Clicked="Excluir_Clicked"/>

    </VerticalStackLayout>

</ContentPage>