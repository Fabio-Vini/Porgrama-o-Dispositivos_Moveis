<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TarefasApp.EditarTarefaPage"
             Title="EditarTarefaPage">
    <VerticalStackLayout Padding="20" Spacing="15">

        <Entry x:Name="TituloEntry"
           Placeholder="Título"/>

        <Entry x:Name="DescricaoEntry"
           Placeholder="Descrição"/>

        <DatePicker x:Name="DataPicker"/>

        <Picker x:Name="PrioridadePicker"
            Title="Prioridade">
            <Picker.Items>
                <x:String>Baixa</x:String>
                <x:String>Média</x:String>
                <x:String>Alta</x:String>
            </Picker.Items>
        </Picker>
        
        <Button Text="Voltar"
         Clicked="Voltar_Clicked"/>
        
        <Button Text="Salvar"
            Clicked="Salvar_Clicked"/>

        <Button Text="Cancelar"
            Clicked="Cancelar_Clicked"/>

    </VerticalStackLayout>
</ContentPage>