<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TP_01.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="15"
            VerticalOptions="Center">

            <Label
                Text="Aplicação Teste"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center"/>

            <Entry 
                x:Name="entryId"
                Placeholder="Digite seu ID"/>
            
            <Entry 
                x:Name="entrySenha"
                Placeholder="Digite sua senha"
                IsPassword="True"/>

            <Button 
                Text="OK"
                Clicked="OnOkClicked"/>

            <Button
                Text="Limpar"
                Clicked="OnLimparClicked"/>

            <Button
                Text="Créditos"
                Clicked="OnCreditosClicked"/>
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
